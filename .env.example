# ===========================
# Barbearia Vikings - Environment Variables
# ===========================
# Copie este arquivo para .env e preencha os valores

# --- Database ---
DATABASE_URL="postgresql://vikinges:vikinges_secret@localhost:5432/barbearia_vikinges?schema=public"
POSTGRES_USER=vikinges
POSTGRES_PASSWORD=vikinges_secret
POSTGRES_DB=barbearia_vikinges

# --- Backend ---
PORT=3333
NODE_ENV=development
TZ=America/Sao_Paulo

# --- JWT ---
JWT_SECRET=CHANGE_ME_to_a_random_secret_key
JWT_REFRESH_SECRET=CHANGE_ME_to_another_random_secret_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS ---
CORS_ORIGIN=http://localhost:5173

# --- WhatsApp (futuro) ---
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
